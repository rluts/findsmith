# Minimal local development settings. Copy to .env and fill in the values:
#   cp .env.example .env
# Never commit .env. See CONTRIBUTING.md for every option.

DEBUG=true

# Base64 of exactly 64 random bytes: openssl rand -base64 64 | tr -d '\n'
COOKIE_KEY=

# Owner-only OAuth 2 access token from Meta-Wiki; replaces the login flow and
# requires DEBUG=true.
OWNER_ACCESS_TOKEN=

USER_AGENT="FindSmith-dev/0.1 (https://gitlab.wikimedia.org/toolforge-repos/findsmith; you@example.org)"

# Local MariaDB from mariadb-docker.sh. The name must start with "<user>__".
DATABASE_HOST=127.0.0.1
DATABASE_NAME=findsmith__dev
TOOL_TOOLSDB_USER=findsmith
TOOL_TOOLSDB_PASSWORD=change-me
